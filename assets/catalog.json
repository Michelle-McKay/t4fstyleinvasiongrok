  {
   "id": "bld",
   "title": "Buildings (85)",
   "note": "Square, transparent, one building complex on a clean square pad. Lock the look first: make your favourite tier 1 image for one building, then attach it as a reference to every other prompt so the set matches. Do all five tiers of one building together."
  },
  {
   "id": "head",
   "title": "Building sheet backdrops (17)",
   "note": "The wide scenery behind a building on its info sheet. NO building in it: leave an empty flat patch of ground in the lower centre where the game places the building."
  },
  {
   "id": "troop",
   "title": "Troops (16)",
   "note": "One unit type per image, transparent, same camera. A squad for infantry and a single vehicle for the rest. Do tier 1 to 4 of a class together and attach tier 1 as a reference."
  },
  {
   "id": "wall",
   "title": "Wall defenses (16)",
   "note": "Defensive emplacements that guard your base wall. Transparent, same camera."
  },
  {
   "id": "hero",
   "title": "Heroes (3)",
   "note": "Bust portraits with a clean, bright backdrop, no transparency."
  },
  {
   "id": "map",
   "title": "Map features (26)",
   "note": "Sprites for the world map, transparent. Shown small, so bold shapes and strong colour."
  },
  {
   "id": "tile",
   "title": "Ground tiles (6)",
   "note": "Flat, straight top-down textures with NO perspective and NO objects. The game bends them onto the map, so edges must tile seamlessly."
  },
  {
   "id": "pack",
   "title": "Pack banners (16)",
   "note": "The big picture at the top of each store pack: a clean, bright loot still life with a colour glow behind it. Rarity colours: 1 green, 2 teal, 3 indigo, 4 magenta, 5 gold."
  },
  {
   "id": "gem",
   "title": "Diamond pile icons (6)",
   "note": "Six sizes of diamond pile for the diamond packs, transparent."
  },
  {
   "id": "icon",
   "title": "HUD icons (21)",
   "note": "Small glossy icons, front view, transparent. They replace the flat HUD icons wherever the game shows them, so check the HUD looks right after adding them."
